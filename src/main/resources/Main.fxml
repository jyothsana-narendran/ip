<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<AnchorPane prefHeight="600.0" prefWidth="400.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="michael.MainController">
    <ScrollPane fx:id="scrollPane" prefHeight="535.0" prefWidth="385.0" hbarPolicy="NEVER" vbarPolicy="ALWAYS" fitToWidth="true" AnchorPane.topAnchor="1.0" AnchorPane.leftAnchor="1.0" AnchorPane.rightAnchor="15.0" AnchorPane.bottomAnchor="50.0">
        <content><VBox fx:id="dialogContainer" fillWidth="true" /></content>
    </ScrollPane>
    <TextField fx:id="userInput" promptText="Enter a command, e.g. todo read a book" prefHeight="41.0" prefWidth="325.0" onAction="#handleUserInput" AnchorPane.leftAnchor="1.0" AnchorPane.rightAnchor="56.0" AnchorPane.bottomAnchor="1.0" />
    <Button text="Send" prefWidth="55.0" onAction="#handleUserInput" AnchorPane.rightAnchor="1.0" AnchorPane.bottomAnchor="1.0" />
</AnchorPane>
